# Copy to .env and adjust. All values have sensible defaults.

# Address the app listens on (behind your TLS-terminating reverse proxy).
HOST=0.0.0.0
PORT=8080

# Where media, SQLite, and the session secret live. Mount a volume here in prod.
DATA_DIR=./data

# Largest accepted upload (default 2 GiB). Oversized uploads are rejected
# rather than silently truncated. Accepts a size suffix as well as a bare byte
# count — `GiB`/`MiB` are binary, `GB`/`MB` decimal, and they are not synonyms.
# MAX_UPLOAD_BYTES=2GiB

# ffmpeg / ffprobe binaries used for transcoding. Defaults assume they are on
# PATH; set absolute paths if they live elsewhere. When they aren't runnable,
# uploads are refused (503) and the Dashboard shows a banner.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# Cap how much disk this instance may use — worth setting when the box runs
# other services. The quota is a ceiling on total media bytes and is unlimited
# when unset; the free-disk floor is independent of it and defaults to 1 GiB,
# because a filesystem with no room left can wedge or corrupt SQLite.
# At either ceiling, uploads and transcode retries are refused with a 507.
# Nothing is ever deleted to make room, and playback is never gated.
# STORAGE_QUOTA_BYTES=200GiB
# MIN_FREE_DISK_BYTES=1GiB

# How hard transcoding is allowed to hit this machine — worth setting when the
# box also runs other services. Concurrency caps how many transcodes run at
# once; FFMPEG_THREADS caps what each one costs, since ffmpeg otherwise uses
# every core. Queued uploads still complete, they just wait their turn.
# TRANSCODE_CONCURRENCY=2
# FFMPEG_THREADS=

# Optional: override the session-signing secret. When unset, a random secret is
# generated on first run and persisted in the database, so sessions survive
# restarts without any configuration.
# SESSION_SECRET=

# Set to true when a reverse proxy terminates TLS, so the session cookie is
# marked Secure. Leave false for plain-HTTP local development.
COOKIE_SECURE=false

# Per-IP rate limiting on the public Viewer surface. Defaults are generous
# enough for normal HLS playback while slowing floods; password attempts
# (Video + Folder unlock) get a much tighter bucket to resist brute-forcing.
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=600
# RATE_LIMIT_PASSWORD_MAX=10
