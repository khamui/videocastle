# Copy to .env and adjust. All values have sensible defaults.

# Address the app listens on (behind your TLS-terminating reverse proxy).
HOST=0.0.0.0
PORT=8080

# Where media, SQLite, and the session secret live. Mount a volume here in prod.
DATA_DIR=./data

# Optional: override the session-signing secret. When unset, a random secret is
# generated on first run and persisted in the database, so sessions survive
# restarts without any configuration.
# SESSION_SECRET=

# Set to true when a reverse proxy terminates TLS, so the session cookie is
# marked Secure. Leave false for plain-HTTP local development.
COOKIE_SECURE=false
